<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <EmbeddedResource Include="Database/001_initial.sql" LogicalName="TaskService.Schema" />
    <EmbeddedResource Include="Database/002_reports.sql" LogicalName="TaskService.Reports" />
    <EmbeddedResource Include="Database/003_invoices.sql" LogicalName="TaskService.Invoices" />
    <EmbeddedResource Include="Database/004_appointment_confirmation.sql" LogicalName="TaskService.AppointmentConfirmation" />
    <EmbeddedResource Include="Database/005_platform_administration.sql" LogicalName="TaskService.PlatformAdministration" />
  </ItemGroup>
</Project>
